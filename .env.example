# Optional environment file for docker compose.
# Copy to .env and adjust.

# Create a lab automatically when the container starts.
SIMULATOR_AUTO_START=false
SIMULATOR_TOTAL=10
SIMULATOR_HIGH=2
SIMULATOR_MEDIUM=4
SIMULATOR_LOW=3
SIMULATOR_UNREACHABLE=1

# NetFlow / IPFIX-style export to the Datadog Agent on the Ubuntu host.
NETFLOW_COLLECTOR_HOST=host.docker.internal
NETFLOW_COLLECTOR_PORT=2055
NETFLOW_VERSION=9
NETFLOW_EXPORT_INTERVAL=5
